PUSH_PLUS_TEMPLATE=html
PUSH_PLUS_CHANNEL=wechat
PUSH_PLUS_WEBHOOK=
PUSH_PLUS_CALLBACKURL=
PUSH_PLUS_TO=

# 微加机器人
WE_PLUS_BOT_TOKEN=
WE_PLUS_BOT_RECEIVER=
WE_PLUS_BOT_VERSION=pro

# qmsg
QMSG_KEY=
QMSG_TYPE=

# 企业微信
QYWX_ORIGIN=
QYWX_AM=
QYWX_KEY=

# Telegram
TG_BOT_TOKEN=
TG_USER_ID=
