# ===== 雨云签到配置 (纯协议版) =====

# 雨云 API 密钥 (必填)
# 获取方式: 雨云控制台 → 用户中心 → API 密钥
RAINYUN_API_KEY=

# ===== 运行配置 (可选) =====
# 雨云 API 地址
API_BASE_URL=https://api.v2.rainyun.com
# 积分兑换比例
POINTS_TO_CNY_RATE=2000
# API 请求超时(秒)
REQUEST_TIMEOUT=15

# ===== 服务器管理功能 (可选) =====
# 雨云 API 密钥（同上，用于续费功能）
# 不填则跳过服务器到期检查和自动续费功能
# RAINYUN_API_KEY=

# 自动续费开关 (true/false)
AUTO_RENEW=true

# 续费触发阈值：剩余多少天时触发续费 (默认7天)
RENEW_THRESHOLD_DAYS=7

# 续费白名单：只续费指定的产品ID (逗号分隔，留空则续费所有)
# 产品ID可在雨云后台查看，或从日志中获取
# 示例：RENEW_PRODUCT_IDS=44500,44501
RENEW_PRODUCT_IDS=

# 续费价格兜底值
DEFAULT_RENEW_COST_7_DAYS=2258

# ===== 推送服务 (可选) =====
# 说明：任意服务配置了 key/必要字段后即启用，可同时配置多个
# 一言开关（true/false），设置为 false 可关闭一言追加
HITOKOTO=true
# 控制台输出开关（true/false）
CONSOLE=false
# 跳过推送的标题列表（使用换行分隔）
SKIP_PUSH_TITLE=

# Bark
BARK_PUSH=
BARK_ARCHIVE=
BARK_GROUP=
BARK_SOUND=
BARK_ICON=
BARK_LEVEL=
BARK_URL=

# 钉钉机器人
DD_BOT_TOKEN=
DD_BOT_SECRET=

# 飞书机器人
FSKEY=
FSSECRET=

# go-cqhttp
GOBOT_URL=
GOBOT_QQ=
GOBOT_TOKEN=

# Gotify
GOTIFY_URL=
GOTIFY_TOKEN=
GOTIFY_PRIORITY=0

# iGot
IGOT_PUSH_KEY=

# Server酱
PUSH_KEY=

# PushDeer
DEER_KEY=
DEER_URL=

# Synology Chat
CHAT_URL=
CHAT_TOKEN=

